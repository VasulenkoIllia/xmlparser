      "joinMatched": true,
      "ignoreValues": ["Ні", "Нет", "No"]
    },
    { "type": "field",         "header": "vendor",           "from": ["vendor"] },

    { "type": "picture_image", "header": "picture" },
    { "type": "field",         "header": "url",              "from": ["url"] },
    { "type": "attribute",     "header": "id",               "from": ["id"] },
    { "type": "attribute",     "header": "group_id",         "from": ["group_id"] },
    { "type": "attribute",     "header": "available",        "from": ["available"] },
    { "type": "attribute",     "header": "in_stock",         "from": ["in_stock"] },
    { "type": "field",         "header": "category_id",      "from": ["categoryId"] },
    { "type": "field",         "header": "currency",         "from": ["currencyId"] },
    { "type": "field",         "header": "description",      "from": ["description"] },

    { "type": "param", "header": "Колір",              "names": ["Колір", "Базовий колір"] },
    { "type": "param", "header": "Стать",              "names": ["Стать", "Пол"] },
    { "type": "param", "header": "Призначення",        "names": ["Призначення", "Предназначение"] },
    { "type": "param", "header": "Склад",              "names": ["Склад"] },
    { "type": "param", "header": "Англійська назва",   "names": ["Англійське найменування"] },
    { "type": "param", "header": "Вид",                "names": ["Вид"] },
    { "type": "param", "header": "Тип",                "names": ["Тип"] },
    { "type": "param", "header": "Вага",               "names": ["Вага"] },
    { "type": "param", "header": "Країна бренду",      "names": ["Країна реєстрації бренду"] },
    { "type": "param", "header": "Висота (см)",        "names": ["Висота (см.)"] },
    { "type": "param", "header": "Довжина (см)",       "names": ["Довжина (см.)"] },
    { "type": "param", "header": "Ширина (см)",        "names": ["Ширина (см.)"] },
    { "type": "param", "header": "Діаметр (см)",       "names": ["Діаметр чаші (см.)"] },
    { "type": "param", "header": "Матеріал поверхні",  "names": ["Матеріал поверхні м'яча"] },
    { "type": "param", "header": "Тип з'єднання",      "names": ["Тип з'єднання панелей"] },
    { "type": "param", "header": "Тип м'яча",          "names": ["Тип мяча"] },
    { "type": "param", "header": "Клас м'яча",         "names": ["Клас м'яча"] }
  ]
