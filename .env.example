# Google service account creds (required)
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Telegram bot notifications (optional but recommended)
# Create bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional for authenticated feeds (Arnica)
ARNICA_LOGIN=
ARNICA_PASSWORD=

# Tuning (optional, defaults shown)
FEED_DELAY_MS=15000
CHUNK_ROWS=1500
WRITE_RETRIES=3
RETRY_DELAY_MS=2000
LOCK_TTL_HOURS=12
